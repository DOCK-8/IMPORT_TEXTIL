// Prisma schema for World Map Countries with Percentage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id         String   @id @default(uuid())
  code       String   @unique // ISO Alpha-3 or numeric code (e.g. USA, FRA, BRA)
  name       String
  percentage Float    @default(50.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
